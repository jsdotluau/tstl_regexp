local RegExp = require("./src")
local polyfill = require("@pkg/polyfill")

local test = polyfill.__TS__New(RegExp, "foo")
assert(test.source == "foo", "incorrect source")
assert(test.flags == "", "incorrect flags")
assert(test.lastIndex == 0, "incorrect lastIndex")
assert(test.dotAll == false, "bad flag")
assert(test.global == false, "bad flag")
assert(test.hasIndices == false, "bad flag")
assert(test.ignoreCase == false, "bad flag")
assert(test.multiline == false, "bad flag")
assert(test.sticky == false, "bad flag")
assert(test.unicode == false, "bad flag")
assert(test.unicodeSets == false, "bad flag")

assert(test:test("table football, foosball") == true, "did not match")
assert(test.lastIndex == 9, "bad lastIndex after match")
